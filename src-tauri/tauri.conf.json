{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quan Voice",
  "version": "0.2.0",
  "identifier": "com.quanvoice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5188",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quan Voice",
        "width": 980,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
