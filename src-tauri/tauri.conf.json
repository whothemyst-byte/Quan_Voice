{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quan Voice",
  "version": "0.1.0",
  "identifier": "com.quanvoice.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5188",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quan Voice",
        "width": 980,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
